{
  "name": "search-open",
  "version": "0.2.0",
  "description": "Search your vault and open the match, with a preview pane. A simplified fork of Floating Search by Boninall.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "bun test && node --test tests/*.test.cjs",
    "lint": "eslint --max-warnings 0 .",
    "check": "bun run lint && bun run lint:unresolved-types && bun run knip && bun run typecheck && bun run test && bun run audit && bun run build",
    "test:unit": "bun test",
    "test:regression": "node --test tests/*.test.cjs",
    "test:e2e": "bun run build && wdio run ./test/wdio.conf.mts",
    "test:e2e:container": "bash scripts/e2e-container.sh",
    "screenshot": "bun run build && SCREENSHOTS=1 wdio run ./test/wdio.conf.mts",
    "typecheck": "tsc --noEmit && tsc -p test",
    "audit": "bun audit",
    "lint:unresolved-types": "node scripts/lint-without-moment.mjs",
    "knip": "knip"
  },
  "keywords": [],
  "author": "Hugo Haas",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.50",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "mocha": "^12.0.3",
    "obsidian": "^1.12.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0"
  },
  "dependencies": {
    "monkey-around": "^3.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
