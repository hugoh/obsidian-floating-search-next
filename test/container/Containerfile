# A Linux box with what Obsidian needs to run under a virtual display, so the
# e2e tests do not take over a developer's screen. Renovate keeps the digest current.
FROM docker.io/library/node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates fonts-liberation herbstluftwm x11-xserver-utils xvfb \
      libasound2 libatk-bridge2.0-0 libdrm2 libgbm1 libgtk-3-0 libnss3 \
      libx11-xcb1 libxkbcommon0 libxss1 libxtst6 \
 && rm -rf /var/lib/apt/lists/*

# Keep in step with mise.toml.
RUN npm install --global bun@1.4.4

COPY run-e2e.sh /usr/local/bin/run-e2e
ENTRYPOINT ["run-e2e"]
