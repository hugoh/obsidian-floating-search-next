amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v3.1.3/hk-config@3.1.3#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base
    // CHANGELOG.md is generated by release-please
    ["rumdl"] = (Base.base["rumdl"]) {
        exclude = List("CHANGELOG.md")
    }
    ["rumdl_format"] = (Base.base["rumdl_format"]) {
        exclude = List("CHANGELOG.md")
    }
    // eslint-plugin-obsidianmd: the same rules the community-plugin review applies
    ["obsidian_lint"] {
        glob = List("src/**/*.ts", "test/**/*.ts", "manifest.json", "eslint.config.mjs", "package.json")
        check = "bun run lint"
    }
    ["obsidian_lint_unresolved_types"] {
        glob = List("src/**/*.ts")
        check = "bun run lint:unresolved-types"
    }
    ["audit"] {
        glob = List("package.json", "bun.lock")
        check = "bun audit"
    }
    // unused files, exports and dependencies; see knip.json
    ["knip"] {
        glob = List("src/**/*.ts", "test/**/*.ts", "tests/**", "scripts/**", "knip.json", "package.json", "bun.lock")
        check = "bun run knip"
    }
    ["typecheck"] {
        glob = List("**/*.ts", "**/*.mts", "tsconfig*.json", "test/tsconfig.json")
        check = "bun run typecheck"
    }
    ["test"] {
        glob = List("src/**/*.ts", "tests/**", "test/**/*.ts")
        check = "bun run test"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ...Base.commit_msg
        }
    }
}
